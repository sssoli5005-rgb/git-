# Server-side AI provider (Groq is tried first; Gemini is the fallback).
# Keep API keys private. Do not add them to VITE_* variables or commit real values.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# The Worker compares museum images with Gemini's approximate visual score.
# This is not a CLIP embedding score; update the same Worker variable to tune it.
SCANNER_MATCH_THRESHOLD=0.80

# Heritage search uses free public indexes and does not require an additional API key.

# Admin login. Use APP_PASSWORD_HASH (salt$base64-scrypt-hash) or ADMIN_PASSWORD.
APP_USERNAME=
APP_PASSWORD_HASH=
ADMIN_PASSWORD=
APP_SESSION_SECRET=

# Optional local Ollama server for development chat and image scanning.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_VISION_MODEL=gemma3:4b
# Scanner ensemble. Models run locally through Ollama and are Apache-2.0 licensed.
# Check installed tags with: ollama list
QWEN_VISION_MODEL=qwen2.5vl:7b
INTERNVL_VISION_MODEL=internvl3:8b
