# =========================
# CHAT — dedicated chat models and credentials only
# =========================
CHAT_GROQ_API_KEY=
CHAT_GROQ_MODEL=qwen/qwen3.8-27b
CHAT_GEMINI_API_KEY=
CHAT_GEMINI_MODEL=gemini-3.8-flash
CHAT_OPENROUTER_API_KEY=
CHAT_OPENROUTER_MODEL=openai/gpt-oss-20b
# Optional local model for chat only (development).
CHAT_OLLAMA_BASE_URL=
CHAT_OLLAMA_MODEL=qwen2.5:14b

# =========================
# SCANNER — dedicated image-analysis models and credentials only
# =========================
SCANNER_GEMINI_API_KEY=
SCANNER_GEMINI_VISION_MODEL=gemini-3.8-flash
SCANNER_GEMINI_VISION_FALLBACK_MODEL=
SCANNER_GROQ_API_KEY=
SCANNER_GROQ_MODEL=qwen/qwen3.8-27b
SCANNER_GROQ_VISION_MODEL=qwen/qwen3.8-27b
SCANNER_GROQ_WEB_SEARCH_MODEL=
SCANNER_OPENROUTER_API_KEY=
# Optional local vision models for scanning only.
SCANNER_OLLAMA_BASE_URL=
SCANNER_OLLAMA_VISION_MODEL=gemma3:4b
SCANNER_QWEN_VISION_MODEL=qwen2.5vl:7b
SCANNER_INTERNVL_VISION_MODEL=internvl3:8b

# Cloudflare Workers AI binding (env.AI) is scanner-only.
# It is not passed to /api/chat.
SCANNER_FREE_FALLBACK_ENABLED=true
SCANNER_INDEX_URL=http://127.0.0.1:8765
SCANNER_INDEX_TIMEOUT_MS=12000
SCANNER_INDEX_MATCH_THRESHOLD=0.85
SCANNER_PROBABLE_THRESHOLD=0.65
SCANNER_MATCH_THRESHOLD=0.80

# Admin login. Use APP_PASSWORD_HASH (salt$base64-scrypt-hash) or ADMIN_PASSWORD.
APP_USERNAME=
APP_PASSWORD_HASH=
ADMIN_PASSWORD=
APP_SESSION_SECRET=
