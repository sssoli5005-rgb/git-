# Image scanner uses independent peer providers: Cloudflare -> Gemini -> Groq -> OpenRouter -> OpenAI -> Mistral -> Anthropic.
# Each optional hosted provider requires its own API key, quota and potentially paid billing.
# No provider key is unlimited. Keep keys private; never add them to VITE_* variables or commit real values.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=

# Optional independent vision peers. Configure keys only for services you have enabled.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.4-mini
MISTRAL_API_KEY=
MISTRAL_VISION_MODEL=mistral-small-latest
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-haiku-5-5

# Free public fallback for image identification (no API keys required).
# Automatically used when no hosted vision provider is configured or all providers fail/are rate-limited.
# Chains: Wikimedia Commons -> Wikipedia -> Wikidata -> Met Museum (all key-less, free).
SCANNER_FREE_FALLBACK_ENABLED=true

# Optional local FAISS/OpenCLIP index service. It runs free beside the app.
SCANNER_INDEX_URL=http://127.0.0.1:8765
SCANNER_INDEX_TIMEOUT_MS=12000
SCANNER_INDEX_MATCH_THRESHOLD=0.85
SCANNER_PROBABLE_THRESHOLD=0.65

# Legacy online visual-comparison threshold; only used if the FAISS index is not decisive.
SCANNER_MATCH_THRESHOLD=0.80

# Heritage search uses free public indexes and does not require an additional API key.

# Admin login. Use APP_PASSWORD_HASH (salt$base64-scrypt-hash) or ADMIN_PASSWORD.
APP_USERNAME=
APP_PASSWORD_HASH=
ADMIN_PASSWORD=
APP_SESSION_SECRET=

# Optional local Ollama server for development chat and image scanning.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_VISION_MODEL=gemma3:4b
# Scanner ensemble. Models run locally through Ollama and are Apache-2.0 licensed.
# Check installed tags with: ollama list
QWEN_VISION_MODEL=qwen2.5vl:7b
INTERNVL_VISION_MODEL=internvl3:8b
